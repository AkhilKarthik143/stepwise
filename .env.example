# Copy to .env.local for local dev. Never commit .env.local.
# On Azure these are Container Apps secrets / env vars (see DEPLOY.md).

# Claude: Anthropic key (preferred, starts with sk-ant-) or an OpenRouter key as fallback
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Cartesia voice: Sonic speaks, Ink listens. Without a key the browser's own voice is used.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=ef191366-f52f-447a-a398-ed8c0f2943a1
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2

# Optional: passcode lock for a public URL (unset = no lock)
APP_PASSCODE=

# Optional: Azure Application Insights (set on Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING=
