# ─────────────────────────────────────────────────────────────────────────────
# AR Technician Assistant — environment template
# Copy to `.env` and fill in:   cp .env.example .env
# Sections mirror config.py (the single source of truth for these settings).
# ─────────────────────────────────────────────────────────────────────────────

# === Gemini Multimodal Live API ============================================
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Live (bidiGenerateContent) model — MUST be a Live-capable model id:
#   gemini-2.0-flash-live-001           GA, half-cascade, robust tool calling (default)
#   gemini-live-2.5-flash               newer half-cascade (best for tool calling)
#   gemini-live-2.5-flash-native-audio  native audio (best voice; tools more limited)
#   gemini-2.0-flash-exp                classic v1alpha experimental
# NOTE: plain "gemini-2.5-flash" is NOT a Live model (no bidiGenerateContent).
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Websocket API version segment. The brief specifies v1alpha; some GA models are
# only reachable on v1beta. If your model 404s on connect, try the other one.
GEMINI_API_VERSION=v1alpha

# Prebuilt TTS voice (half-cascade models): Puck, Charon, Kore, Fenrir, Aoede
GEMINI_VOICE=Puck

# OPTIONAL: BCP-47 speech language for the session (e.g. de-DE, es-ES, ja-JP).
# Empty = field omitted from the setup frame (the verified English default).
GEMINI_LANGUAGE_CODE=

# Realtime-input wire format. false = typed audio/video fields (current API);
# true = legacy mediaChunks list (needed by some older/experimental models).
GEMINI_USE_MEDIA_CHUNKS=false
# Auto-reconnect the Gemini Live session on drop / goAway / time-limit (keeps the
# WebRTC link up so a long job doesn't lose the assistant). Backoff is exponential.
GEMINI_RECONNECT=true
GEMINI_MAX_RECONNECTS=5
GEMINI_RECONNECT_BACKOFF=1.0
# Use Gemini session-resumption handles for context continuity across reconnects.
GEMINI_SESSION_RESUMPTION=true
# Min seconds a session must stay up to count as "healthy" (resets reconnect
# backoff) — stops a setup-then-instant-drop flap from reconnecting forever.
GEMINI_MIN_HEALTHY_SECONDS=10
# Live captions: ask Gemini to transcribe its own spoken output (drives captions
# + the session transcript on the client). false = voice-only.
GEMINI_OUTPUT_TRANSCRIPTION=true
# Also transcribe the TECHNICIAN's speech so the transcript is two-sided (verify
# the AI heard "M8", not "N8"). false = record only the assistant's side.
GEMINI_INPUT_TRANSCRIPTION=true
# Max characters accepted for a typed user message over the WebRTC data channel
# (the loud-environment text fallback). Oversized input is dropped.
USER_TEXT_MAX_CHARS=2000

# === NotebookLM RAG knowledge base =========================================
# Base dir for notebooklm-py config/credentials (default: ~/.notebooklm).
NOTEBOOKLM_HOME=
# OPTIONAL: absolute path to a specific storage_state.json (overrides HOME).
NOTEBOOKLM_STORAGE=
# OPTIONAL: named profile (resolves to ~/.notebooklm/profiles/<name>/...).
NOTEBOOKLM_PROFILE=
# The notebook the assistant queries. Find it with:  notebooklm list
ACTIVE_NOTEBOOK_ID=your-notebook-id-here
# Per-tool-call timeout for the manual lookup (seconds). NotebookLM's first query
# on a notebook is a cold start (~40-45s); warm follow-ups are much faster.
NOTEBOOKLM_TIMEOUT_SECONDS=90
# Resolve fuller citation context (SKILL.md: cited_text is often a snippet).
# true = richer grounding, one extra RPC per cited source (slower).
NOTEBOOKLM_RESOLVE_CITATIONS=false
# Max citations included in the grounding block handed to Gemini.
NOTEBOOKLM_MAX_CITATIONS=5

# --- v2 speed ---------------------------------------------------------------
# Keep ONE long-lived NotebookLM client (skips per-call connect/auth setup).
NOTEBOOKLM_WARM_CLIENT=true
# Cookie keepalive for the long-lived client (seconds; 0 = off). >0 keeps an
# unattended worker's Google cookies fresh (values <60 are clamped up).
NOTEBOOKLM_KEEPALIVE_SECONDS=0
# L1 exact-match answer cache: time-to-live (s) and max entries (0 disables).
NOTEBOOKLM_CACHE_TTL_SECONDS=300
NOTEBOOKLM_CACHE_MAXSIZE=256
# Pre-warm the notebook on startup/connect so the first lookup isn't a cold start.
NOTEBOOKLM_PREWARM=true
# The throwaway query the pre-warm sends (only used when NOTEBOOKLM_PREWARM=true).
NOTEBOOKLM_PREWARM_QUERY=Briefly, what equipment or topic does this manual cover?

# --- v2 speed L2: near-duplicate answer cache (token-cosine over prior queries).
# A strong paraphrase of a question you already answered reuses the answer instead
# of paying the round-trip again. High threshold = only the SAME question hits.
NOTEBOOKLM_SIMILARITY_CACHE=true
NOTEBOOKLM_SIMILARITY_THRESHOLD=0.86
NOTEBOOKLM_SIMILARITY_MAXSIZE=128

# --- v2 speed L3: local BM25 index over the notebook's source fulltext.
# Built once in the background after the warm client is up (one get_fulltext RPC
# per source). Two roles below.
NOTEBOOKLM_LOCAL_INDEX=true
# Resilience: when the live NotebookLM call times out / is rate-limited / errors,
# return the top VERBATIM manual passages (grounded) instead of an apology.
NOTEBOOKLM_LOCAL_FALLBACK=true
# Aggressive speed: answer straight from the local index (skip the slow call) when
# the top match is very strong. OFF by default — NotebookLM's synthesis is the
# quality path; this trades some answer quality for latency.
NOTEBOOKLM_LOCAL_FAST_PATH=false
NOTEBOOKLM_LOCAL_FAST_PATH_MIN_SCORE=12.0
# Passages returned per local answer, and the index size cap (bounds memory/scan).
NOTEBOOKLM_LOCAL_PASSAGES=3
NOTEBOOKLM_INDEX_MAX_CHUNKS=2000

# === Media tuning ===========================================================
VIDEO_FPS=1.0              # frames/sec forwarded to Gemini (Live cap is <= 1)
VIDEO_MAX_WIDTH=768        # downscale width before JPEG encode
VIDEO_JPEG_QUALITY=70      # 1-100

# === HTTP(S) server ========================================================
HOST=0.0.0.0
PORT=8443
# TLS (required for WebXR/getUserMedia over LAN — see README). Leave blank for
# plain HTTP on the same port (fine for http://localhost desktop testing).
SSL_CERTFILE=certs/cert.pem
SSL_KEYFILE=certs/key.pem
# Public STUN server for NAT traversal.
STUN_URL=stun:stun.l.google.com:19302
# TURN relay — set all three for real-world NAT traversal (factory/symmetric NAT).
# Served to the browser via the auth-gated /ice-config endpoint.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Python logging level: DEBUG, INFO, WARNING, ERROR.
# (Read directly by main.py at startup, not via config.py.)
LOG_LEVEL=INFO

# === Security / limits =====================================================
# Comma-separated allowed CORS origins; "*" = open (dev). Lock down for prod,
# e.g. ALLOWED_ORIGINS=https://ar.yourco.com
ALLOWED_ORIGINS=*
# Max concurrent live sessions before /offer returns 429 (cost/DoS guard).
MAX_SESSIONS=25
# Per-client-IP /offer requests per 60s (0 disables).
RATE_LIMIT_PER_MIN=30
# Max accepted /offer body size in bytes.
MAX_OFFER_BYTES=262144
# Optional bearer token required on /offer AND /ice-config (so TURN credentials
# can't be harvested unauthenticated). Empty = no auth (dev). When set, the client
# sends it as X-API-Key (from ?token=... in the URL or localStorage.apiToken);
# `Authorization: Bearer <token>` is also accepted.
API_AUTH_TOKEN=
# Only trust the X-Forwarded-For header for the client IP when behind a proxy you
# control (it's client-spoofable otherwise -> rate-limit bypass + memory growth).
TRUST_FORWARDED_FOR=false
# Cap the number of distinct client IPs the rate limiter tracks (bounds memory).
RATE_LIMIT_MAX_IPS=10000
# Session reaper: an abandoned headset must not hold a MAX_SESSIONS slot + a live
# Gemini connection forever. Max wall-clock seconds per session (0 disables).
SESSION_MAX_SECONDS=14400
# Reap after this long with NO inbound media frames at all (0 disables).
SESSION_IDLE_SECONDS=300
