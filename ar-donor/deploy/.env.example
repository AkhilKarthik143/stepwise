# Copy to deploy/.env and fill EVERY value, then: sudo docker compose up -d --build
# (deploy/.env is gitignored — never commit real secrets.)

# The DNS name that points to this VM's public IP (free option: DuckDNS).
# Caddy fetches HTTPS for exactly this name.
APP_DOMAIN=yourname.duckdns.org

# --- Core secrets (copy from your Render service's Environment, or your .env) ---
GEMINI_API_KEY=
API_AUTH_TOKEN=
AUTH_USERS_JSON=

# Your Vercel site origin (scheme + host, no trailing slash).
ALLOWED_ORIGINS=https://ar-technician-assistant.vercel.app

# --- TURN relay (your Metered credentials) ---
TURN_URL=turn:YOURSUBDOMAIN.metered.live:80,turn:YOURSUBDOMAIN.metered.live:443,turns:YOURSUBDOMAIN.metered.live:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# Behind Caddy's proxy -> trust X-Forwarded-For for correct per-client rate limiting.
TRUST_FORWARDED_FOR=true

# --- Optional: NVIDIA recognizer (chat "Detect" button) ---
# Enables /recognize (identify parts + read model/part numbers from a photo).
# Free key at https://build.nvidia.com/settings/api-keys (starts nvapi-).
# NVIDIA_API_KEY=
# NVIDIA_VLM_MODEL=meta/llama-3.2-90b-vision-instruct

# --- Optional: chat + image-generation model names (use your GEMINI_API_KEY) ---
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Optional: NotebookLM grounding in the cloud ---
# ACTIVE_NOTEBOOK_ID=8f03eac0-8214-40f1-adae-30d37c7de989
# Paste the FULL contents of your local ~/.notebooklm/.../storage_state.json here
# (one line). Cookies expire — re-export when grounding stops. Treat as a secret.
# NOTEBOOKLM_STORAGE_STATE_JSON=
